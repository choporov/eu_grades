TELEGRAM_BOT_TOKEN=

# local або drive
GRADES_SOURCE=local
GRADES_LOCAL_DIR=examples

# Потрібно для GRADES_SOURCE=drive, а також для GRADES_SOURCE=local,
# якщо в локальній Google Drive папці є файли *.gsheet
GRADES_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

BOT_TIMEZONE=Europe/Kyiv
DATA_DIR=.bot_data
# TTL автоматичного перечитування локального джерела. Для GRADES_SOURCE=drive
# кеш оновлюється окремою фоновою задачею кожні 15 хвилин.
CACHE_TTL_SECONDS=300
# Після 30 хв без успішного оновлення бот попереджає про застарілі дані.
CACHE_STALE_AFTER_SECONDS=1800
SEND_EMPTY_SUMMARIES=true
